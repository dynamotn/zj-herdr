// zj-herdr: example Zellij configuration.
//
// Merge these blocks into ~/.config/zellij/config.kdl. Build the plugin with
//   cargo build -p zj-herdr-plugin --target wasm32-wasip1 --release
// and copy target/wasm32-wasip1/release/zj_herdr.wasm to the location below.

plugins {
    zj_herdr location="file:~/.config/zellij/plugins/zj_herdr.wasm" {
        // Stay open after Enter or an attention jump (for a pinned pane).
        // pinned "false"

        // `zj-herdr prompt` pipes to this alias (the daemon's `plugin`
        // setting, "zj_herdr" by default) with deliver_prompts "true" added,
        // which Zellij loads as its own floating instance. Do not set
        // deliver_prompts here: every picker pane would type each prompt.

        // Used once at load to fetch the first snapshot without waiting for
        // the daemon's next push. Use an absolute path if Zellij's PATH
        // does not include it.
        // zj_herdr_bin "zj-herdr"

        // Start the daemon from Zellij instead of a service manager. It logs
        // to $XDG_STATE_HOME/zj-herdr/daemon.log and outlives Zellij.
        // start_daemon "true"

        // "cards" (default), "comfortable" or "compact".
        // density "cards"

        // Name each tab after the directory of its first agent, unless you
        // renamed it. "false" turns it off.
        // rename_tabs "true"
    }
}

keybinds {
    shared_except "locked" {
        // Open the floating picker: j/k or arrows move, Enter jumps,
        // n/p cycle attention, Esc or q hides it.
        bind "Alt a" {
            LaunchOrFocusPlugin "zj_herdr" {
                floating true
                move_to_focused_tab true
            }
        }
        // Jump to the next / previous agent that needs you
        // (blocked first, then idle), across sessions. If the plugin is not
        // loaded yet, it is launched floating, never as a tiled pane, and
        // hides itself after the jump (or at once when nobody needs you).
        bind "Alt ]" {
            MessagePlugin "zj_herdr" {
                name "zj_herdr.cmd.v1"
                payload "attention-next"
                floating true
            }
        }
        bind "Alt [" {
            MessagePlugin "zj_herdr" {
                name "zj_herdr.cmd.v1"
                payload "attention-prev"
                floating true
            }
        }
        // Switch to the next / previous Zellij session, by name.
        bind "Alt }" {
            MessagePlugin "zj_herdr" {
                name "zj_herdr.cmd.v1"
                payload "session-next"
                floating true
            }
        }
        bind "Alt {" {
            MessagePlugin "zj_herdr" {
                name "zj_herdr.cmd.v1"
                payload "session-prev"
                floating true
            }
        }

        // Drive the pinned rail of the layout below, which is unselectable
        // and so never gets keys of its own. Zellij delivers a pipe to the
        // instances whose URL and configuration match, so these binds
        // repeat the rail's options (here `pinned "true"` and
        // `deliver_prompts "false"`) exactly. `name`, `payload` and
        // `floating` are not part of the configuration. Every rail of the
        // session gets the message; only the one in the active tab acts.
        // If no rail matches, Zellij launches a floating one instead: check
        // that the options are the same as in the layout.
        bind "Ctrl Alt j" {
            MessagePlugin "zj_herdr" {
                name "zj_herdr.cmd.v1"
                payload "select-next"
                floating true
                pinned "true"
                deliver_prompts "false"
            }
        }
        bind "Ctrl Alt k" {
            MessagePlugin "zj_herdr" {
                name "zj_herdr.cmd.v1"
                payload "select-prev"
                floating true
                pinned "true"
                deliver_prompts "false"
            }
        }
        bind "Ctrl Alt g" {
            MessagePlugin "zj_herdr" {
                name "zj_herdr.cmd.v1"
                payload "jump"
                floating true
                pinned "true"
                deliver_prompts "false"
            }
        }
    }
}

// Optional: a pinned, narrow agent list in a layout. Its configuration
// differs from the alias above, so Zellij treats it as a separate instance;
// prompts and attention keys keep going to the alias.
//
// layout {
//     pane split_direction="vertical" {
//         pane
//         pane size=44 {
//             plugin location="zj_herdr" {
//                 pinned "true"
//                 deliver_prompts "false"
//             }
//         }
//     }
// }
